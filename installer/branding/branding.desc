---
componentName: constos
welcomeStyleCalamares: true
welcomeExpandingLogo: true
windowExpanding: normal
windowSize: 800px,520px
windowPlacement: center
slideshow: [ logo-black.svg ]

strings:
    productName:         ConstOS
    version:             Alpha
    shortVersion:        Alpha
    versionedName:       ConstOS Alpha
    shortVersionedName:  ConstOS Alpha
    bootloaderEntryName: ConstOS
    productUrl:          https://github.com/alifconstantine/const-os
