---
componentName: constos
welcomeStyleCalamares: true
welcomeExpandingLogo: true
windowExpanding: normal
windowSize: 800px,520px
windowPlacement: center

strings:
    productName:         ConstOS
    version:             1.0.0 (Harness Edition)
    shortVersion:        1.0
    versionedName:       ConstOS 1.0 "Harness Edition"
    shortVersionedName:  ConstOS 1.0
    bootloaderEntryName: ConstOS
    productUrl:          https://github.com/alifconstantine/const-os
    supportUrl:          https://github.com/alifconstantine/const-os/issues
    knownIssuesUrl:      https://github.com/alifconstantine/const-os/issues
    releaseNotesUrl:     https://github.com/alifconstantine/const-os/releases

images:
    productLogo:         "const-logo-dark.png"
    productIcon:         "icon.png"
    productWelcome:      "const-logo-dark.png"

style:
   SidebarBackground:    "#161616"
   SidebarText:          "#FFFFFF"
   SidebarTextCurrent:   "#FFFFFF"
   SidebarBackgroundCurrent: "#262626"

slideshow:               "show.qml"
